{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hasaneyldrm/exercises-dataset/blob/main/data/exercises.schema.json",
  "title": "Exercises Dataset",
  "description": "Array of exercise records with stable slugs, localized content, and media references.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/exercise"
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "properties": {
        "en": { "type": "string" },
        "es": { "type": "string" },
        "pt-br": { "type": "string" }
      },
      "required": ["en", "es", "pt-br"],
      "additionalProperties": false
    },
    "localizedContent": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["name", "steps"],
      "additionalProperties": false
    },
    "exercise": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "body_part": {
          "type": "string",
          "description": "Stable body-part slug. Translated labels live in taxonomy.json."
        },
        "equipment": {
          "type": "string",
          "description": "Stable equipment slug. Translated labels live in taxonomy.json."
        },
        "muscles": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "secondary": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "required": ["primary", "secondary"],
          "additionalProperties": false
        },
        "i18n": {
          "type": "object",
          "properties": {
            "en": { "$ref": "#/$defs/localizedContent" },
            "es": { "$ref": "#/$defs/localizedContent" },
            "pt-br": { "$ref": "#/$defs/localizedContent" }
          },
          "required": ["en", "es", "pt-br"],
          "additionalProperties": false
        },
        "media": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "thumbnail": {
              "type": "string",
              "pattern": "^images/.+\\.(jpg|jpeg|png)$"
            },
            "animation": {
              "type": "string",
              "pattern": "^videos/.+\\.gif$"
            },
            "attribution": { "type": "string", "minLength": 1 }
          },
          "required": ["id", "thumbnail", "animation", "attribution"],
          "additionalProperties": false
        }
      },
      "required": ["id", "body_part", "equipment", "muscles", "i18n", "media"],
      "additionalProperties": false
    }
  }
}
